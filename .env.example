# Supabase → Connect → "Session pooler" (IPv4, porta 5432) serve para os dois em dev.
# A conexão direta (db.<ref>.supabase.co) é só IPv6; o transaction pooler (6543) exige ?pgbouncer=true.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase: URL e publishable key são públicas; a service role nunca vai ao cliente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tarefas seguintes
# Provedor de IA: "gemini" (padrão, free tier em ai.google.dev) ou "anthropic".
AI_PROVIDER=gemini

# Gemini: chave gratuita em https://aistudio.google.com/apikey (sem cartão).
GOOGLE_API_KEY=

# Anthropic: só se AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Só necessário se a chave for de organização (não de um workspace específico):
# a API exige o ID do workspace nesse caso. Console → Settings → Workspace → General.
ANTHROPIC_WORKSPACE_ID=

# Opcionais: modelo por tarefa, sobrescreve o padrão do provedor ativo.
AI_MODEL_EXTRACT=
AI_MODEL_CATEGORIZE=
AI_MODEL_SIMPLE=
AI_MODEL_ANSWER=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
STORAGE_BUCKET=cifra-uploads
AI_MONTHLY_BUDGET_CENTS_PER_USER=50
